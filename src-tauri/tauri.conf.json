{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "game-collection",
  "version": "0.1.0",
  "identifier": "de.cfe.game-collection",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "game-collection",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/byChratos/Game-Collection/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0OTU2NDU3QUI3MDM5MzMKUldRek9YQ3JWMlNWOUJZckUxTHovSW5Cb1VoVzR2UlB4ODNMMXFSSE9idnM2eHFDMXNWYWdscTMK"
    }
  }
}

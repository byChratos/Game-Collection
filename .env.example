# Copy to ".env" (same folder as docker-compose.yml) and adjust.
# Compose picks ".env" up automatically; it fills the ${...} placeholders in docker-compose.yml.

# Address under which OTHER machines can reach coturn. "localhost" only works if
# every peer runs on the Docker host itself. Use the LAN IP for a local network,
# or the public IP / hostname when peers connect over the internet.
# Keep this in sync with "external-ip" in coturn/turnserver.conf.
TURN_HOST=192.168.178.21

# Must match the "user=<name>:<password>" line in coturn/turnserver.conf.
TURN_USERNAME=webrtc
TURN_CREDENTIAL=changeme
